# ------------------------------------------------------------
# GitHub API (recommended)
# ------------------------------------------------------------
# Personal access token for higher GitHub API rate limits.
GITHUB_TOKEN=

# ------------------------------------------------------------
# Azure OpenAI (primary path used in this repo)
# ------------------------------------------------------------
OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Multi-model comparison — JSON array or comma-separated:
# AZURE_OPENAI_DEPLOYMENT=["gpt-5","gpt-5-mini","gpt-5-nano"]
# AZURE_OPENAI_DEPLOYMENT=gpt-5,gpt-5-mini

# ------------------------------------------------------------
# Optional non-Azure fallback (used by some scripts)
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
