# ------------------------------------------------------------
# GitHub API (recommended)
# ------------------------------------------------------------
# Personal access token for higher GitHub API rate limits.
GITHUB_TOKEN=

# ------------------------------------------------------------
# LLM Provider — set this to switch backends without code changes
# Supported: azure | openai | anthropic | mistral | ollama | gemini
# ------------------------------------------------------------
LLM_PROVIDER=azure

# AZURE_OPENAI_DEPLOYMENT holds the model/deployment name(s) for
# whichever provider is active. Supports JSON array or comma-separated
# for multi-model comparison runs:
#   AZURE_OPENAI_DEPLOYMENT=gpt-4o
#   AZURE_OPENAI_DEPLOYMENT=["gpt-5","gpt-5-mini","gpt-5-nano"]
#   AZURE_OPENAI_DEPLOYMENT=gpt-5,gpt-5-mini
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ------------------------------------------------------------
# Azure OpenAI  (LLM_PROVIDER=azure)
# ------------------------------------------------------------
OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ------------------------------------------------------------
# OpenAI  (LLM_PROVIDER=openai)
# ------------------------------------------------------------
# OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ------------------------------------------------------------
# Anthropic  (LLM_PROVIDER=anthropic)
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=claude-3-5-sonnet-20241022

# ------------------------------------------------------------
# Mistral  (LLM_PROVIDER=mistral)
# ------------------------------------------------------------
# MISTRAL_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=mistral-small-latest

# ------------------------------------------------------------
# Ollama — local models  (LLM_PROVIDER=ollama)
# ------------------------------------------------------------
# OLLAMA_API_BASE=http://localhost:11434   # optional, this is the default
# AZURE_OPENAI_DEPLOYMENT=llama3

# ------------------------------------------------------------
# Google Gemini  (LLM_PROVIDER=gemini)
# ------------------------------------------------------------
# GEMINI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gemini/gemini-1.5-pro
